# Lion Rock — Supabase connection
#
# Copy this file to `.env` and fill in your real values:
#
#   cp .env.example .env
#
# `.env` is gitignored, so your real values never get committed.
#
# Get these from your Supabase dashboard:
#   Project Settings → API → Project URL and the `anon` / public key.

# Your Supabase project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The `anon` / public key (the long eyJ... JWT).
# This one is safe to expose in client-side code — Row Level Security is what
# actually gates writes. Do NOT put the `service_role` key here: that key
# bypasses RLS entirely and must never reach the browser.
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Storage bucket the walkthrough videos upload into.
# Created for you by supabase/schema.sql — leave as-is unless you renamed it.
SUPABASE_BUCKET=walkthrough-videos


# ---------------------------------------------------------------------------
# IMPORTANT — this site has no build step
# ---------------------------------------------------------------------------
# Nothing bundles this .env into the page, so the browser cannot read it on its
# own. The file the browser actually loads is:
#
#   assets/js/supabase-config.js
#
# That file is also gitignored. To set it up, copy the committed template and
# paste the same two values in:
#
#   cp assets/js/supabase-config.example.js assets/js/supabase-config.js
#
# Keep this .env as the canonical record of the values (and for any future
# scripts or tooling); keep supabase-config.js as the copy the browser reads.
#
# On Netlify, set SUPABASE_URL / SUPABASE_ANON_KEY under
# Site configuration → Environment variables, then generate
# supabase-config.js at deploy time — see README section 5.
